---
import { version as astroVersion } from "astro/package.json";
---

<footer class="site-footer">
  <p>© 2026 Openise News. Built with Astro {astroVersion}.</p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    text-align: center;
  }

  .site-footer p {
    margin: 0;
  }
</style>
