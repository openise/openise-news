---
import { formatDate, toISODate } from "../domain/date";

interface Props {
  title: string;
  href: string;
  createdDate: string;
  description: string;
  headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const { title, href, createdDate, description, headingLevel = 3 } = Astro.props;
const cardId = `content-card-${crypto.randomUUID()}`;
const HeadingTag = `h${headingLevel}` as "h2" | "h3" | "h4" | "h5" | "h6";
---

<a href={href} class="content-card-link" aria-labelledby={`${cardId}-title`} aria-describedby={`${cardId}-meta ${cardId}-description`}>
  <article class="content-card">
    <p class="content-card-meta" id={`${cardId}-meta`}>
      <time datetime={toISODate(createdDate)}>{formatDate(createdDate)}</time>
    </p>
    <HeadingTag class="content-card-title">
      <span class="content-card-title-text" id={`${cardId}-title`}>{title}</span>
    </HeadingTag>
    <p class="content-card-description" id={`${cardId}-description`}>{description}</p>
  </article>
</a>

<style>
  .content-card-link { display: block; height: 100%; color: inherit; text-decoration: none; border-radius: .5rem; }
  .content-card-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .content-card-link:hover .content-card,
  .content-card-link:focus-visible .content-card { border-color: var(--color-accent); }
  .content-card { display: flex; height: 100%; flex-direction: column; border: 1px solid var(--color-border); border-radius: .5rem; padding: 1rem; }
  .content-card-title { display: flex; align-items: center; gap: .5rem; margin: 0 0 .5rem; font-size: 1.25rem; font-weight: 700; }
  p { margin: 0; }
  .content-card-meta { display: flex; flex-wrap: wrap; gap: .25rem .75rem; margin-bottom: .25rem; color: var(--color-muted); font-size: .875rem; font-weight: 500; }
  .content-card-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    margin-bottom: .75rem;
    color: var(--color-muted);
    font-size: .875rem;
    line-height: 1.625;
  }
  /* 長い英単語のタイトルが一覧の grid 列を押し広げないよう、min-content も縮める anywhere を使う（break-word は min-content を縮めない） */
  .content-card-title-text { overflow-wrap: anywhere; }
</style>
