---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h1 class="news-title">{title}</h1>

<style>
  .news-title {
    margin: 0;
    color: var(--color-text);
    font-size: clamp(1.5rem, 4vw, 1.875rem);
    font-weight: 800;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
</style>
