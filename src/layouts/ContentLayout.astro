---
import BaseLayout from "./BaseLayout.astro";
import { ARTICLE_TYPOGRAPHY_CLASSES } from "../constants/typography";

interface Props {
  /** 省略すると BaseLayout と同じくサイト名だけのタイトルになる（トップページ用） */
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="content-shell">
    <article class:list={["content-article", ARTICLE_TYPOGRAPHY_CLASSES]}>
      {
        Astro.slots.has("header") && (
          <header class="content-header not-prose">
            <slot name="header" />
          </header>
        )
      }
      <slot />
    </article>
  </div>
</BaseLayout>

<script>
  import { wrapTables } from "../scripts/client/table-scroll";

  wrapTables();
</script>

<style>
  .content-shell {
    /* 本文の左端 max(16px, (画面幅 - 1098px) / 2) は openise-daily ・ openise-wiki ・ openise-theme で揃えている（daily: src/layouts/BaseLayout.astro の <main>、wiki: src/layouts/ContentLayout.astro の .content-shell と src/styles/global.css の .page-shell、theme: src/styles/global.css の .site-main） */
    width: min(100% - 2rem, 1098px);
    margin-inline: auto;
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }

  @media (max-width: 40rem) {
    .content-shell {
      padding-top: 1rem;
      padding-bottom: 1.5rem;
    }
  }

  /* 本文の最大幅は openise-daily ・ openise-wiki ・ openise-theme で 50rem に揃えている（daily: src/layouts/ContentLayout.astro、wiki: src/layouts/ContentLayout.astro、theme: src/styles/global.css） */
  .content-article {
    max-width: 50rem;
  }

  .content-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* prose の見出しの margin-top（h2 で 2em）が .content-header の margin-bottom と相殺されて勝つため、本文の先頭要素の上の余白を 0 にして区切り線の下の空白を margin-bottom だけで決める */
  .content-header + :global(*) {
    margin-top: 0;
  }
</style>
