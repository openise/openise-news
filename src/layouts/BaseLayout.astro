---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { getThemeBootstrapScript } from "../scripts/client/theme-contract";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "AI 関連ニュースのピックアップ",
} = Astro.props;
const themeBootstrapScript = getThemeBootstrapScript();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline set:html={themeBootstrapScript}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
