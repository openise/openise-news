---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getThemeBootstrapScript } from "../scripts/client/theme-contract";

const SITE_NAME = "Openise News";

interface Props {
  /** 省略するとサイト名だけのタイトルになる（トップページ用） */
  title?: string;
  description?: string;
  /** false にすると canonical の代わりに noindex を出力する（404 ページ用） */
  canonical?: boolean;
}

const {
  title,
  description = "AI 関連ニュースのピックアップ",
  canonical = true,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// site を設定しない Container API のテストでも描画できるよう、リクエストの origin で代用する
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const themeBootstrapScript = getThemeBootstrapScript();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {canonical ? <link rel="canonical" href={canonicalURL} /> : <meta name="robots" content="noindex" />}
    <slot name="head" />
    <script is:inline set:html={themeBootstrapScript}></script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
