---
import { getCollection } from "astro:content";
import { formatDate, toISODate } from "../domain/date";
import { latestNews } from "../domain/news";
import { routes } from "../domain/routes";
import BaseLayout from "../layouts/BaseLayout.astro";

const latest = latestNews(await getCollection("news"));
---

<BaseLayout title="Openise News">
  <div class="page-shell home">
    <h1>Openise News</h1>
    <p>AI 関連ニュースのピックアップ</p>
    {latest && (
      <a class="latest-news-button" href={routes.newsItem(latest.id)}>
        <span class="latest-news-label">最新 News</span>
        <time datetime={toISODate(latest.data.createdDate)}>{formatDate(latest.data.createdDate)}</time>
        <span class="latest-news-arrow" aria-hidden="true">→</span>
      </a>
    )}
    <p><a class="news-list-link" href={routes.news()}>News の一覧</a></p>
  </div>
</BaseLayout>

<style>
  .home { display: grid; gap: 1rem; }
  .home h1, .home p { margin: 0; }
  .latest-news-button { display: flex; align-items: center; gap: .75rem; width: 100%; min-width: 0; padding: .5rem 1rem; white-space: nowrap; border: 1px solid var(--color-button-bg); border-radius: .5rem; background: var(--color-button-bg); color: var(--color-button-text); text-decoration: none; }
  .latest-news-label, .latest-news-button time, .latest-news-arrow { flex-shrink: 0; }
  .latest-news-label { font-weight: 600; }
  .latest-news-button time { color: inherit; opacity: .85; }
  .latest-news-arrow { margin-left: auto; }
  .latest-news-button:hover, .latest-news-button:focus-visible { border-color: var(--color-button-bg-hover); background: var(--color-button-bg-hover); }
  .latest-news-button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
