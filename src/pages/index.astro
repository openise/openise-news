---
import { getCollection, render } from "astro:content";
import NewsHeader from "../components/NewsHeader.astro";
import { latestNews } from "../domain/news";
import { routes } from "../domain/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentLayout from "../layouts/ContentLayout.astro";

const latest = latestNews(await getCollection("news"));
const Content = latest ? (await render(latest)).Content : undefined;
---

{latest && Content ? (
  <ContentLayout>
    <NewsHeader slot="header" title={latest.data.title} />
    <Content />
    <p class="not-prose news-list"><a class="news-list-link" href={routes.news()}>News の一覧</a></p>
  </ContentLayout>
) : (
  <BaseLayout>
    <div class="page-shell home">
      <h1>Openise News</h1>
      <p>AI 関連ニュースのピックアップ</p>
      <p><a class="news-list-link" href={routes.news()}>News の一覧</a></p>
    </div>
  </BaseLayout>
)}

<style>
  .home { display: grid; gap: 1rem; }
  .home h1, .home p { margin: 0; }
  .news-list { margin: 2.5rem 0 0; }
</style>
