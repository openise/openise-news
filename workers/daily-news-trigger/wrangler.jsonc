{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openise-news-trigger",
  "main": "index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // 毎日 00:47 JST（Cron Triggers は UTC）
    "crons": ["47 15 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
