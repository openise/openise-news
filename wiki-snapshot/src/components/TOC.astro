---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  showToggle?: boolean;
  collapse?: boolean;
}

const { headings, showToggle = true, collapse = true } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 6);
const minDepth = items.length > 0 ? Math.min(...items.map((heading) => heading.depth)) : 2;
const visibleCount = collapse ? 8 : items.length;
const hasMore = items.length > visibleCount;
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="目次">
      <details open>
        <summary class="toc-summary" hidden={!showToggle}>
          <span class="toc-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            目次
          </span>
          <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <ul class="toc-list">
          {items.map((heading, index) => (
            <li
              class:list={["toc-item", { "toc-extra hidden": hasMore && index >= visibleCount }]}
              style={`--toc-indent: ${heading.depth - minDepth}`}
            >
              <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
            </li>
          ))}
          {hasMore && (
            <li>
              <button class="toc-expand-btn" type="button">+ {items.length - visibleCount} 件</button>
            </li>
          )}
        </ul>
      </details>
    </nav>
  )
}

<style>
  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-summary[hidden] {
    display: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toc-chevron {
    transition: transform 0.2s ease;
  }

  details[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    padding-left: calc(var(--toc-indent, 0) * 1rem);
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0.25rem 0.375rem 0.625rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link[aria-current="location"] {
    color: var(--color-text);
    font-weight: 600;
    border-left-color: var(--color-text);
  }

  .toc-expand-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.375rem 0.25rem 0.375rem 0.625rem;
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: none;
    border: 0;
    border-left: 2px solid transparent;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .toc-expand-btn:hover {
    color: var(--color-text);
  }

  .toc-expand-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
